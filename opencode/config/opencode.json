{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "@playwright/mcp@latest"
      ],
      "enabled": true
    }
  },
  "provider": {
    "mlx": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "MLX (local)",
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1"
      },
      "models": {
        "mlx-community/Qwen3.6-35B-A3B-4bit": {
          "name": "MLX Qwen 3.6 MoE 35B A3B"
        },
        "mlx-community/Qwen3.6-35B-A3B-4bit-DWQ": {
          "name": "MLX Qwen 3.6 DWQ MoE 35B A3B"
        }
      }
    },
    "llama.cpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama.cpp (local)",
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1"
      },
      "models": {
        "unsloth/Qwen3.6-27B-GGUF:UD-Q6_K_XL": {
          "name": "GGUF Qwen 3.6 27B Q6"
        },
        "unsloth/Qwen3.6-35B-A3B-GGUF:Q6_K_XL": {
          "name": "GGUF Qwen 3.6 MoE 35B A3B Q6"
        }
      }
    },
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio (local)",
      "options": {
        "baseURL": "http://127.0.0.1:1234/v1"
      },
      "models": {
        "zai-org/glm-4.7-flash": {
          "name": "GLM 4.7 Flash 30b"
        },
        "qwen/qwen3.5-9b": {
          "name": "Qwen 3.5 9b"
        }
      }
    },
    "mtplx": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "MTPLX (local)",
      "options": {
        "baseURL": "http://127.0.0.1:8000/v1",
        "timeout": false,
        "chunkTimeout": 900000,
        "headers": {
          "x-mtplx-client": "opencode"
        }
      },
      "models": {
        "mtplx-qwen38-27b-optimized-speed": {
          "name": "MTPLX Qwen-3.8-27B-optimized-speed",
          "reasoning": false,
          "tool_call": true,
          "temperature": false,
          "limit": {
            "context": 262144,
            "output": 262144
          },
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          }
        }
      }
    }
  }
}